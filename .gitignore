.env
.env.local
.env.*.local
.env.production
*.pem
*.key
secrets/
**/application-local.yml
**/application-secret.yml

# ----- Java / Maven / Gradle -----
target/
build/
*.class
*.jar
*.war
*.ear
*.iml
.gradle/
.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*

# ----- Spring Boot -----
spring-boot-application.log
HELP.md

# ----- Node / npm / pnpm -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ----- Build front (React + Vite) -----
dist/
dist-ssr/
.vite/
*.local

# ----- TypeScript -----
*.tsbuildinfo

# ----- IDE / Éditeurs -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Docker -----
docker-compose.override.yml
.docker/

# ----- Logs / coverage -----
logs/
*.log
coverage/
.nyc_output/

# ----- Bases de données locales -----
*.db
*.sqlite
*.sqlite3
postgres-data/
pgdata/

# ----- Divers -----
.cache/
tmp/
temp/

# ----- Documents officiels du stage (privés) -----
docs/01-cahier-des-charges/
