# Exemple de configuration locale pour backend-app.
# Copier ce fichier en .env et remplir les valeurs.
# Le .env est ignore par Git (ne jamais le committer).

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5434/skillforge
DB_USER=skillforge
DB_PASSWORD=skillforge_dev

# Serveur (8080 est souvent deja pris par d'autres outils, on utilise 8090 par defaut)
SERVER_PORT=8090

# JWT (a generer en production)
JWT_SECRET=change-me-in-production-this-secret-must-be-at-least-32-characters-long

# Fournisseur de modele de langage : mock | openai | claude
LLM_PROVIDER=mock

# OpenAI (si LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude / Anthropic (si LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
