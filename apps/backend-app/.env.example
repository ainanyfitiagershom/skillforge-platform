# Exemple de configuration locale pour backend-app.
# Copier ce fichier en .env et remplir les valeurs.
# Le .env est ignore par Git (ne jamais le committer).

# Base de donnees
DB_URL=jdbc:postgresql://localhost:5434/skillforge
DB_USER=skillforge
DB_PASSWORD=skillforge_dev

# Serveur (8080 est souvent deja pris par d'autres outils, on utilise 8090 par defaut)
SERVER_PORT=8090

# JWT (a generer en production)
JWT_SECRET=change-me-in-production-this-secret-must-be-at-least-32-characters-long

# Fournisseur de modele de langage : mock | openai | github | claude | groq | ollama | gemini
# Recommande 2026 : gemini (free tier 1000 req/jour sur flash-lite, le plus stable)
LLM_PROVIDER=mock

# OpenAI (si LLM_PROVIDER=openai) — payant, 5$ min de recharge
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub Models (si LLM_PROVIDER=github) — RETIRE fin 2026 par GitHub, ne pas utiliser
# Historique conserve pour la reproductibilite du POC 2.
GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference

# Claude / Anthropic (si LLM_PROVIDER=claude) — payant
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Groq (si LLM_PROVIDER=groq) — GRATUIT (30 req/min), remplace GitHub Models.
# Note (2026-11) : Llama 3.x retire, utiliser qwen/qwen3.8-27b ou openai/gpt-oss-120b.
# Cle a creer sur https://console.groq.com/keys (inscription gratuite Google/GitHub).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Ollama (si LLM_PROVIDER=ollama) — LLM 100% local, aucun cout, aucun quota.
# Conteneur skillforge-ollama demarre via docker-compose (port 11434).
# Apres le premier `docker compose up`, telecharger le modele :
#   docker exec skillforge-ollama ollama pull qwen2.5:7b
# Necessite ~5 Go de disque et 8 Go de RAM libres.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini (si LLM_PROVIDER=gemini) — GRATUIT et stable en 2026.
# Free tier flash-lite : 15 req/min, 1000 req/jour (le plus genereux du marche).
# Free tier flash : 10 req/min, 250 req/jour (meilleure qualite).
# Cle a creer sur https://aistudio.google.com/apikey (aucun paiement requis).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash-lite

# Backend Sandbox (service distinct port 8091)
SANDBOX_URL=http://localhost:8091
SANDBOX_INTERNAL_KEY=dev-internal-key-please-change
