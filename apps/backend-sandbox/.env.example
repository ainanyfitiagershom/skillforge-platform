# Configuration locale pour backend-sandbox.
# Copier en .env et adapter.

# Port du service sandbox (different de backend-app sur 8090)
SERVER_PORT=8091

# Cle interne partagee avec backend-app (devra etre forte en production)
SANDBOX_INTERNAL_KEY=dev-internal-key-please-change

# Endpoint Docker (par defaut socket Unix sur Linux)
DOCKER_HOST_URI=unix:///var/run/docker.sock

# Chemin vers le profil seccomp.
# Laisser vide pour utiliser le defaut (relatif au repo) : ../../infra/sandbox/seccomp/skillforge-seccomp.json
# Si vous lancez depuis un autre dossier, mettre un chemin absolu ici.
SECCOMP_PROFILE_PATH=
